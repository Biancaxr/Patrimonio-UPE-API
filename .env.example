# URL usada pela API em tempo de execução. Em Neon/Supabase pode ser a conexão com pool.
DATABASE_URL="postgresql://usuario:senha@host:5432/patrimonio?sslmode=require"

# URL direta usada exclusivamente por migrations. Se omitida, DATABASE_URL será usada.
DIRECT_URL="postgresql://usuario:senha@host:5432/patrimonio?sslmode=require"

JWT_SECRET="troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
PORT=3333

# Usadas somente por `npm run db:seed` para criar ou atualizar o administrador inicial.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@upe.br"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Origens web permitidas, separadas por vírgula. Aplicativos nativos não dependem de CORS.
WEB_ORIGIN="http://localhost:5173,https://seu-portal.exemplo.br"
